            "https://www.freedesktop.org/software/systemd/man/latest/journalctl.html"
          ],
          "snippets": [
            "sudo journalctl --vacuum-size=500M",
            "# /etc/systemd/journald.conf.d/size.conf\n[Journal]\nSystemMaxUse=500M"
          ],
          "text": "journalctl --vacuum-size removes the oldest archived journal files until the journal fits the size once. SystemMaxUse= in a journald.conf drop-in caps it from then on. Both delete old log entries. kipple never runs them: they need root.",
          "title": "Cap the journal's size"
        }
      ],
      "id": "journald",
      "lens": "system",
      "omissions": []
    },
    {
      "advice": [
        {
          "references": [
            "https://wiki.archlinux.org/title/Pacman#Cleaning_the_package_cache"
          ],
          "snippets": [
            "sudo paccache -rk3",
            "sudo systemctl enable --now paccache.timer"
          ],
          "text": "paccache, from pacman-contrib, removes cached packages except the newest versions of each. Keeping three lets you roll back a bad upgrade without the network; keeping fewer saves more space but leaves fewer versions to downgrade to. paccache.timer runs it every week. kipple never runs it: it needs root.",
          "title": "Keep fewer old packages with paccache"
        }
      ],
