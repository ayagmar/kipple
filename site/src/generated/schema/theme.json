{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kipple theme",
  "description": "A kipple theme file: a style for each role. A role left out comes from the theme it extends, else the terminal's own style.",
  "type": "object",
  "properties": {
    "extends": {
      "description": "The theme this one starts from: a built-in or another theme of yours.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "roles": {
      "type": "object",
      "properties": {
        "accent": {
          "$ref": "#/$defs/style"
        },
        "bar.protected": {
          "$ref": "#/$defs/style"
        },
        "bar.review": {
          "$ref": "#/$defs/style"
        },
        "bar.safe": {
          "$ref": "#/$defs/style"
        },
        "bar.track": {
          "$ref": "#/$defs/style"
        },
        "border": {
          "$ref": "#/$defs/style"
        },
        "cursor": {
          "$ref": "#/$defs/style"
        },
        "error": {
          "$ref": "#/$defs/style"
        },
        "kept": {
          "$ref": "#/$defs/style"
        },
        "key": {
          "$ref": "#/$defs/style"
        },
        "key.label": {
          "$ref": "#/$defs/style"
        },
        "label": {
          "$ref": "#/$defs/style"
        },
        "level.current": {
          "$ref": "#/$defs/style"
        },
        "level.other": {
          "$ref": "#/$defs/style"
        },
        "muted": {
          "$ref": "#/$defs/style"
        },
        "protected": {
          "$ref": "#/$defs/style"
        },
        "review": {
          "$ref": "#/$defs/style"
        },
        "safe": {
          "$ref": "#/$defs/style"
        },
        "selected": {
          "$ref": "#/$defs/style"
        },
        "text": {
          "$ref": "#/$defs/style"
        },
        "title": {
          "$ref": "#/$defs/style"
        },
        "warning": {
          "$ref": "#/$defs/style"
        }
      },
      "additionalProperties": false
    },
    "version": {
      "const": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "$defs": {
    "colour": {
      "description": "An ANSI colour name, #rrggbb, an index from 0 to 255, or reset for the terminal's own.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "black",
            "red",
            "green",
            "yellow",
            "blue",
            "magenta",
            "cyan",
            "white",
            "bright-black",
            "bright-red",
            "bright-green",
            "bright-yellow",
            "bright-blue",
            "bright-magenta",
            "bright-cyan",
            "bright-white",
            "reset"
          ]
        },
        {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        {
          "type": "integer",
          "maximum": 255,
          "minimum": 0
        }
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "bg": {
          "$ref": "#/$defs/colour"
        },
        "bold": {
          "type": "boolean"
        },
        "dim": {
          "type": "boolean"
        },
        "fg": {
          "$ref": "#/$defs/colour"
        },
        "italic": {
          "type": "boolean"
        },
        "reversed": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
