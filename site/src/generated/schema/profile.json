{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileOut",
  "description": "A profile.",
  "type": "object",
  "properties": {
    "created": {
      "description": "When it was made, in seconds since 1970 (UTC).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "entries": {
      "description": "One entry per rule proposing removal when it was made, sorted by rule.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntryOut"
      }
    },
    "held": {
      "description": "The kept and excluded paths it was made with, without their notes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/HeldOut"
      }
    },
    "name": {
      "description": "Its name, which is also its file's.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "policy_version": {
      "description": "The classification version it was made under.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "schema": {
      "description": "`kipple.profile/v1`.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "created",
    "policy_version",
    "held",
    "entries"
  ],
  "$defs": {
    "EntryOut": {
      "description": "What a profile froze about one rule.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Whether the config turned it on.",
          "$ref": "#/$defs/RuleState"
        },
        "integration_digest": {
          "description": "SHA-256 of its integration's canonical encoding.",
          "$ref": "#/$defs/Sha256"
        },
        "level": {
          "description": "Its effective level.",
          "$ref": "#/$defs/Level"
        },
        "method": {
          "description": "Its method.",
          "$ref": "#/$defs/Method"
        },
        "recent_days": {
          "description": "Its configured recent window, in days.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "roots": {
          "description": "The roots it resolved to, sorted.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RootOut"
          }
        },
        "rule": {
          "description": "The rule.",
          "type": "string",
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
        },
        "rule_digest": {
          "description": "SHA-256 of the rule's canonical encoding.",
          "$ref": "#/$defs/Sha256"
        },
        "scope": {
          "description": "Whether the profile authorizes it.",
          "$ref": "#/$defs/EntryScope"
        }
      },
      "additionalProperties": false,
      "required": [
        "rule",
        "scope",
        "rule_digest",
        "integration_digest",
        "enabled",
        "level",
        "recent_days",
        "method",
        "roots"
      ]
    },
    "EntryScope": {
      "type": "string",
      "enum": [
        "included",
        "left-out"
      ]
    },
    "FileIdentity": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "HeldKind": {
      "type": "string",
      "enum": [
        "keep",
        "exclude"
      ]
    },
    "HeldOut": {
      "description": "A kept or excluded path.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Which list.",
          "$ref": "#/$defs/HeldKind"
        },
        "path": {
          "description": "The path as configured, `~` expanded.",
          "$ref": "#/$defs/TextOut"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ]
    },
    "Level": {
      "type": "string",
      "enum": [
        "careful",
        "balanced",
        "thorough"
      ]
    },
    "Method": {
      "type": "string",
      "enum": [
        "delete",
        "trash"
      ]
    },
    "RootOut": {
      "description": "A root a rule resolved to.",
      "type": "object",
      "properties": {
        "identity": {
          "description": "Its identity when the scan opened it; `null` when it didn't.",
          "anyOf": [
            {
              "$ref": "#/$defs/FileIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "description": "Its directory.",
          "$ref": "#/$defs/TextOut"
        },
        "root": {
          "description": "Which root.",
          "$ref": "#/$defs/SymbolicRoot"
        }
      },
      "additionalProperties": false,
      "required": [
        "root",
        "path"
      ]
    },
    "RuleState": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SymbolicRoot": {
      "type": "string",
      "enum": [
        "home",
        "xdg.config",
        "xdg.cache",
        "xdg.data",
        "xdg.state",
        "known.local-app-data",
        "known.roaming-app-data",
        "macos.caches",
        "config.project-roots",
        "trash",
        "claude.config",
        "pacman.cache",
        "journald.journal"
      ]
    },
    "TextOut": {
      "description": "A name or a path, exactly: its text when it is valid Unicode, else the OS's own form.",
      "anyOf": [
        {
          "description": "The text.",
          "type": "string"
        },
        {
          "description": "Not valid Unicode.",
          "type": "object",
          "properties": {
            "raw": {
              "description": "Base64 of the bytes (Unix) or UTF-16LE code units (Windows).",
              "type": "string"
            }
          },
          "required": [
            "raw"
          ]
        }
      ]
    }
  }
}
