          "selector": "claude-debug-logs",
          "meaning": "whether every session marker was read and none names this log's session"
        },
        {
          "name": "launcher_target",
          "kind": "bool",
          "selector": "claude-versions",
          "meaning": "whether the launcher points at this version"
        },
        {
          "name": "version_running",
          "kind": "bool",
          "selector": "claude-versions",
          "meaning": "whether a lock file names this version; no lock proves nothing, so that is unknown"
