        {
          "name": "layout",
          "kind": "enum",
          "values": [
            "supported",
            "unknown"
          ],
          "selector": null,
          "meaning": "whether the configuration directory is the one Claude Code uses, on a verified version"
        },
        {
          "name": "claude.version_supported",
          "kind": "enum",
          "values": [
            "supported",
            "unsupported"
          ],
          "selector": null,
          "meaning": "whether the launcher's version equals a verified one; a non-native install shows none, which is unknown"
        },
        {
          "name": "session_closed",
