{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupportMatrixOut",
  "description": "The generated support matrix.",
  "type": "object",
  "properties": {
    "integrations": {
      "description": "Every built-in integration, sorted by ID.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SupportOut"
      }
    },
    "kipple": {
      "description": "kipple's version.",
      "type": "string"
    },
    "schema": {
      "description": "`kipple.support-matrix/v1`.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "kipple",
    "integrations"
  ],
  "$defs": {
    "AreaReach": {
      "description": "What an open area covers.",
      "oneOf": [
        {
          "description": "Exactly that path.",
          "type": "string",
          "const": "exact"
        },
        {
          "description": "Whatever is strictly inside it.",
          "type": "string",
          "const": "inside"
        }
      ]
    },
    "FactInfo": {
      "description": "A fact rules may test.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Its type: `enum`, `bool`, `duration`, `bytes` or `count`.",
          "type": "string"
        },
        "meaning": {
          "description": "What it means.",
          "type": "string"
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "selector": {
          "description": "The one selector it applies to, or `None` for every selector.",
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "description": "An enum fact's values.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "kind",
        "meaning"
      ]
    },
    "LensOut": {
      "description": "A lens, as `--lens` names it.",
      "oneOf": [
        {
          "description": "What AI coding agents leave behind.",
          "type": "string",
          "const": "agents"
        },
        {
          "description": "Developer tools and projects.",
          "type": "string",
          "const": "dev"
        },
        {
          "description": "The operating system and its package managers.",
          "type": "string",
          "const": "system"
        }
      ]
    },
    "OpenInfo": {
      "description": "A part of a state root some integrations may reach.",
      "type": "object",
      "properties": {
        "integrations": {
          "description": "Whose findings may be there.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "description": "Where it is, `/`-separated.",
          "type": "string"
        },
        "reaches": {
          "description": "What it covers.",
          "$ref": "#/$defs/AreaReach"
        },
        "root": {
          "description": "The root.",
          "type": "string"
        }
      },
      "required": [
        "root",
        "path",
        "reaches",
        "integrations"
      ]
    },
    "PathMatch": {
      "description": "What a protected path covers.",
      "oneOf": [
        {
          "description": "That path.",
          "type": "string",
          "const": "exact"
        },
        {
          "description": "Every path whose last component starts as this one's does.",
          "type": "string",
          "const": "prefix"
        }
      ]
    },
    "PlatformSupport": {
      "description": "What an integration does on one platform.",
      "type": "object",
      "properties": {
        "discover": {
          "description": "Whether it finds things there.",
          "type": "boolean"
        },
        "mutate": {
          "description": "Whether one of its rules may change anything there.",
          "type": "boolean"
        },
        "platform": {
          "description": "The platform.",
          "type": "string"
        },
        "report": {
          "description": "Whether it reports sizes or advice there.",
          "type": "boolean"
        }
      },
      "required": [
        "platform",
        "discover",
        "report",
        "mutate"
      ]
    },
    "ProtectedPath": {
      "description": "A path below a state root that stays closed.",
      "type": "object",
      "properties": {
        "matches": {
          "description": "What it covers.",
          "$ref": "#/$defs/PathMatch"
        },
        "path": {
          "description": "The path, `/`-separated.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "matches"
      ]
    },
    "ProtectedRoot": {
      "description": "A state root and what stays closed even inside what it opens.",
      "type": "object",
      "properties": {
        "delegates": {
          "description": "Roots of the same integration that answer for what is inside them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entries": {
          "description": "Paths below it that nothing opens.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtectedPath"
          }
        },
        "root": {
          "description": "The root.",
          "type": "string"
        }
      },
      "required": [
        "root",
        "entries",
        "delegates"
      ]
    },
    "SupportOut": {
      "description": "One integration's support.",
      "type": "object",
      "properties": {
        "facts": {
          "description": "The facts its findings can supply.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactInfo"
          }
        },
        "id": {
          "description": "Its ID.",
          "type": "string"
        },
        "lens": {
          "description": "Its lens.",
          "$ref": "#/$defs/LensOut"
        },
        "open": {
          "description": "What its state roots open, and to whom.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpenInfo"
          }
        },
        "platforms": {
          "description": "What it does on each platform.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlatformSupport"
          }
        },
        "protected": {
          "description": "Its tool's state roots: closed, whether or not it runs here, except for `open`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtectedRoot"
          }
        },
        "rules": {
          "description": "Its rules.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "description": "The upstream versions its layouts were verified against.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "lens",
        "verified",
        "facts",
        "protected",
        "open",
        "rules",
        "platforms"
      ]
    }
  }
}
