    "SlotOut": {
      "description": "A trash slot: the trash directory and the item's name there.",
      "type": "object",
      "properties": {
        "identity": {
          "description": "Its identity.",
          "$ref": "#/$defs/FileIdentity"
        },
        "name": {
          "description": "The item's name in it.",
          "$ref": "#/$defs/TextOut"
        },
        "trash": {
          "description": "The trash directory's path.",
          "$ref": "#/$defs/TextOut"
        }
      },
      "additionalProperties": false,
      "required": [
        "trash",
        "identity",
        "name"
      ]
    },
    "Stop": {
      "type": "string",
      "enum": [
        "cancelled",
        "journal-failed",
        "interrupted"
      ]
    },
    "TextOut": {
      "description": "A name or a path, exactly: its text when it is valid Unicode, else the OS's own form.",
      "anyOf": [
        {
          "description": "The text.",
          "type": "string"
        },
        {
          "description": "Not valid Unicode.",
          "type": "object",
          "properties": {
            "raw": {
              "description": "Base64 of the bytes (Unix) or UTF-16LE code units (Windows).",
              "type": "string"
            }
          },
          "required": [
            "raw"
          ]
        }
      ]
    },
    "TotalsOut": {
      "description": "A receipt's totals.",
      "type": "object",
      "properties": {
        "removed": {
          "description": "What every item removed, as each run reported it.",
          "$ref": "#/$defs/RemovedOut"
        },
        "statuses": {
          "description": "How many items ended in each status.",
          "type": "object",
          "properties": {
            "cancelled": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "done": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "indeterminate": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "trashed_allocated_bytes": {
          "description": "Their allocated size, where every one of them had one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "trashed_apparent_bytes": {
          "description": "Their apparent size, as the scan estimated it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "trashed_items": {
          "description": "Items moved to the trash.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "removed",
        "trashed_items",
        "trashed_apparent_bytes",
        "statuses"
      ]
    },
    "Unjudged": {
      "type": "string",
      "enum": [
        "not-found",
        "unmeasured",
        "unanchored"
      ]
    },
    "UnsupportedOut": {
      "description": "Why kipple doesn't change a file system.",
      "oneOf": [
        {
          "description": "A network file system.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "network"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "A user-space file system.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user-space"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "One without POSIX delete semantics.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "no-posix-delete"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "One kipple doesn't recognise.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unrecognised"
            },
            "name": {
              "description": "What the OS calls it: its file system type name, letters, digits and `._+-`\nonly, at most 64 of them.",
              "type": "string",
              "pattern": "^[A-Za-z0-9._+-]{0,64}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
