              "const": "trash-unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "error"
          ]
        },
        {
          "description": "git couldn't say in full what it tracks inside it.",
          "type": "object",
          "properties": {
            "gap": {
              "description": "Why.",
