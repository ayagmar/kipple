            }
          },
          "additionalProperties": false,
          "required": [
            "skip"
          ]
        },
        {
          "description": "It conflicts with another selected item.",
          "type": "object",
          "properties": {
            "kind": {
              "description": "How.",
              "$ref": "#/$defs/ConflictKind"
            },
            "skip": {
              "type": "string",
              "const": "conflict"
            },
            "with": {
              "description": "The other item's finding, by its ID in the scan planned from.",
