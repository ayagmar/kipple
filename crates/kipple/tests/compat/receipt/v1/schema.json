{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReceiptOut",
  "description": "What a run did, item by item.",
  "type": "object",
  "properties": {
    "ending": {
      "description": "How the command ended.",
      "$ref": "#/$defs/EndingOut"
    },
    "exit": {
      "description": "Its exit code.",
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "items": {
      "description": "Every item of the plan, in plan order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReceiptItemOut"
      }
    },
    "run": {
      "description": "The run, when one was stored.",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "description": "`kipple.receipt/v1`.",
      "type": "string"
    },
    "totals": {
      "description": "The totals.",
      "$ref": "#/$defs/TotalsOut"
    }
  },
  "required": [
    "schema",
    "ending",
    "exit",
    "items",
    "totals"
  ],
  "$defs": {
    "Caution": {
      "type": "string",
      "enum": [
        "recent",
        "recovery",
        "loss",
        "high-cost"
      ]
    },
    "CompletenessOut": {
      "description": "How a finding's size was measured.",
      "oneOf": [
        {
          "description": "Every entry was read.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "complete"
            }
          },
          "additionalProperties": false,
          "required": [
            "state"
          ]
        },
        {
          "description": "Some weren't.",
          "type": "object",
          "properties": {
            "skipped_mounts": {
              "description": "Mounts inside that weren't entered.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "incomplete"
            },
            "unreadable": {
              "description": "Entries that couldn't be read.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "unreadable",
            "skipped_mounts"
          ]
        },
        {
          "description": "The measurement was cancelled.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "state"
          ]
        }
      ]
    },
    "ConflictKind": {
      "type": "string",
      "enum": [
        "overlap",
        "method",
        "scope"
      ]
    },
    "EffectOut": {
      "description": "What a run of an item did.",
      "type": "object",
      "properties": {
        "excluded": {
          "description": "Entries the plan left out from the start, kept as reviewed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "left": {
          "description": "The reviewed entries it didn't remove, by reason.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LeftOut"
          }
        },
        "removed": {
          "description": "What it removed.",
          "$ref": "#/$defs/RemovedOut"
        },
        "trashed": {
          "description": "Where it moved the item, for a trash item that moved.",
          "anyOf": [
            {
              "$ref": "#/$defs/SlotOut"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "removed",
        "left",
        "excluded"
      ]
    },
    "EndingOut": {
      "description": "How a command ended.",
      "oneOf": [
        {
          "description": "Something was done, and nothing failed.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "The plan was empty.",
          "type": "string",
          "const": "nothing-to-clean"
        },
        {
          "description": "Items were planned and none ran.",
          "type": "string",
          "const": "none-ran"
        },
        {
          "description": "The person said no.",
          "type": "string",
          "const": "declined"
        },
        {
          "description": "Every item of a plan file dropped.",
          "type": "string",
          "const": "stale"
        },
        {
          "description": "Something failed or can't be told.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "The store refused.",
          "type": "string",
          "const": "refused"
        },
        {
          "description": "It was cancelled.",
          "type": "string",
          "const": "cancelled"
        }
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "root-changed",
        "root-unreadable",
        "target-missing",
        "target-changed",
        "parent-changed",
        "parent-missing",
        "through-link",
        "mount-boundary",
        "unsupported-file-system",
        "unknown-entry",
        "unreadable",
        "too-large",
        "unsupported",
        "cross-file-system",
        "destination-exists",
        "trash-missing",
        "trash-changed",
        "stranded",
        "unauthorized",
        "journal",
        "unsynced",
        "cancelled",
        "io"
      ]
    },
    "ErrorOut": {
      "description": "What went wrong: kipple's code and the OS error, never the OS's message.",
      "type": "object",
      "properties": {
        "at": {
          "description": "Where below the target, as components, if it is about one entry.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/TextOut"
          }
        },
        "code": {
          "description": "kipple's code.",
          "$ref": "#/$defs/ErrorCode"
        },
        "os_code": {
          "description": "The OS's own number for it, where it has one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "os_kind": {
          "description": "The OS error's kind, if one caused it.",
          "anyOf": [
            {
              "$ref": "#/$defs/OsErrorKind"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code"
      ]
    },
    "EstimateOut": {
      "description": "What the scan estimated removing an item frees.",
      "type": "object",
      "properties": {
        "allocated_bytes": {
          "description": "Allocated storage, where the platform reports it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "apparent_bytes": {
          "description": "Total file length.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "completeness": {
          "description": "How much was measured.",
          "$ref": "#/$defs/CompletenessOut"
        },
        "unique_bytes": {
          "description": "Allocated storage only this item holds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "apparent_bytes",
        "completeness"
      ]
    },
    "FileIdentity": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "FoundOut": {
      "description": "What reconciliation found of an item a crash interrupted.",
      "oneOf": [
        {
          "description": "Nothing authorized was removed.",
          "type": "object",
          "properties": {
            "found": {
              "type": "string",
              "const": "unchanged"
            }
          },
          "additionalProperties": false,
          "required": [
            "found"
          ]
        },
        {
          "description": "The target is gone.",
          "type": "object",
          "properties": {
            "found": {
              "type": "string",
              "const": "gone"
            }
          },
          "additionalProperties": false,
          "required": [
            "found"
          ]
        },
        {
          "description": "Another file is at the target.",
          "type": "object",
          "properties": {
            "found": {
              "type": "string",
              "const": "replaced"
            }
          },
          "additionalProperties": false,
          "required": [
            "found"
          ]
        },
        {
          "description": "Some of its entries are gone.",
          "type": "object",
          "properties": {
            "found": {
              "type": "string",
              "const": "partly-gone"
            },
            "gone": {
              "description": "How many reviewed entries are gone.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "of": {
              "description": "Of how many.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "found",
            "gone",
            "of"
          ]
        },
        {
          "description": "It is in the trash, at its journalled slot.",
          "type": "object",
          "properties": {
            "found": {
              "type": "string",
              "const": "trashed"
            },
            "slot": {
              "description": "Where.",
              "$ref": "#/$defs/SlotOut"
            }
          },
          "additionalProperties": false,
          "required": [
            "found",
            "slot"
          ]
        },
        {
          "description": "It couldn't be checked.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why.",
              "$ref": "#/$defs/ErrorOut"
            },
            "found": {
              "type": "string",
              "const": "unreadable"
            }
          },
          "additionalProperties": false,
          "required": [
            "found",
            "error"
          ]
        },
        {
          "description": "The run's change couldn't be made durable.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why.",
              "$ref": "#/$defs/ErrorOut"
            },
            "found": {
              "type": "string",
              "const": "unsynced"
            }
          },
          "additionalProperties": false,
          "required": [
            "found",
            "error"
          ]
        },
        {
          "description": "Not reconciled yet: running, or interrupted.",
          "type": "object",
          "properties": {
            "found": {
              "type": "string",
              "const": "pending"
            }
          },
          "additionalProperties": false,
          "required": [
            "found"
          ]
        }
      ]
    },
    "GitGap": {
      "type": "string",
      "enum": [
        "git-missing",
        "git-too-old",
        "git-failed",
        "git-truncated",
        "git-other-work-tree",
        "git-unplaced",
        "git-unpassable",
        "nested-repository",
        "git-unsupported"
      ]
    },
    "Hold": {
      "type": "string",
      "enum": [
        "disabled",
        "kept",
        "excluded",
        "report-only",
        "advice",
        "unknown-layout",
        "unknown-consequence",
        "unknown-git",
        "holds-repository",
        "in-use",
        "unknown-activity",
        "unknown-modified"
      ]
    },
    "JudgementField": {
      "type": "string",
      "enum": [
        "rule",
        "level",
        "recent-window",
        "method",
        "held",
        "policy"
      ]
    },
    "LeftOut": {
      "description": "Reviewed entries left for one reason.",
      "type": "object",
      "properties": {
        "count": {
          "description": "How many.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reason": {
          "description": "Why.",
          "$ref": "#/$defs/LeftReason"
        },
        "sample": {
          "description": "At most ten of their paths below the target, as components, in canonical order.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TextOut"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "reason",
        "count",
        "sample"
      ]
    },
    "LeftReason": {
      "type": "string",
      "enum": [
        "gone",
        "replaced",
        "changed",
        "excluded",
        "not-empty",
        "denied",
        "busy",
        "unsupported",
        "failed",
        "not-reached"
      ]
    },
    "Method": {
      "type": "string",
      "enum": [
        "delete",
        "trash"
      ]
    },
    "OsErrorKind": {
      "type": "string",
      "enum": [
        "not-found",
        "permission-denied",
        "already-exists",
        "directory-not-empty",
        "busy",
        "read-only",
        "crosses-devices",
        "not-a-directory",
        "invalid-name",
        "unsupported",
        "storage-full",
        "interrupted",
        "other"
      ]
    },
    "OutcomeOut": {
      "description": "What happened to one item.",
      "oneOf": [
        {
          "description": "Every reviewed entry was removed, or the item moved to the trash.",
          "type": "object",
          "properties": {
            "effect": {
              "description": "What it did.",
              "$ref": "#/$defs/EffectOut"
            },
            "status": {
              "type": "string",
              "const": "done"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "effect"
          ]
        },
        {
          "description": "It ran to the end but left reviewed entries.",
          "type": "object",
          "properties": {
            "effect": {
              "description": "What it did.",
              "$ref": "#/$defs/EffectOut"
            },
            "status": {
              "type": "string",
              "const": "partial"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "effect"
          ]
        },
        {
          "description": "It was dropped before anything of it was touched.",
          "type": "object",
          "properties": {
            "skip": {
              "description": "Why.",
              "$ref": "#/$defs/SkipOut"
            },
            "status": {
              "type": "string",
              "const": "skipped"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "skip"
          ]
        },
        {
          "description": "It stopped on an error; what it removed until then counts.",
          "type": "object",
          "properties": {
            "effect": {
              "description": "What it did until then.",
              "$ref": "#/$defs/EffectOut"
            },
            "error": {
              "description": "The error.",
              "$ref": "#/$defs/ErrorOut"
            },
            "status": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "effect"
          ]
        },
        {
          "description": "The apply was cancelled during it.",
          "type": "object",
          "properties": {
            "effect": {
              "description": "What it did until then.",
              "$ref": "#/$defs/EffectOut"
            },
            "status": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "effect"
          ]
        },
        {
          "description": "A crash interrupted it.",
          "type": "object",
          "properties": {
            "found": {
              "description": "What reconciliation found.",
              "$ref": "#/$defs/FoundOut"
            },
            "status": {
              "type": "string",
              "const": "indeterminate"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "found"
          ]
        }
      ]
    },
    "Protection": {
      "type": "string",
      "enum": [
        "file-system-root",
        "home",
        "subresource"
      ]
    },
    "ReceiptItemOut": {
      "description": "One item of a receipt.",
      "type": "object",
      "properties": {
        "estimate": {
          "description": "What the scan estimated removing it frees.",
          "anyOf": [
            {
              "$ref": "#/$defs/EstimateOut"
            },
            {
              "type": "null"
            }
          ]
        },
        "item": {
          "description": "Its place in the plan, from 0.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "method": {
          "description": "How it was to be removed.",
          "$ref": "#/$defs/Method"
        },
        "outcome": {
          "description": "What happened.",
          "$ref": "#/$defs/OutcomeOut"
        },
        "path": {
          "description": "The finding's path, as shown.",
          "$ref": "#/$defs/TextOut"
        },
        "restored": {
          "description": "How its last restore ended, if it was restored.",
          "anyOf": [
            {
              "$ref": "#/$defs/RestoreOut"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item",
        "path",
        "method",
        "outcome"
      ]
    },
    "RemovedOut": {
      "description": "What an item removed.",
      "type": "object",
      "properties": {
        "estimated_bytes": {
          "description": "Estimated allocated bytes removed, an upper bound.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "names": {
          "description": "Names removed, confirmed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "shared": {
          "description": "Removed names whose file kept another name.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unmeasured": {
          "description": "Removed names whose allocation wasn't known.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "names",
        "estimated_bytes",
        "shared",
        "unmeasured"
      ]
    },
    "RestoreOut": {
      "description": "How a restore ended.",
      "oneOf": [
        {
          "description": "The item is back.",
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "restored"
            }
          },
          "additionalProperties": false,
          "required": [
            "result"
          ]
        },
        {
          "description": "It was refused or failed.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why.",
              "$ref": "#/$defs/ErrorOut"
            },
            "result": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "result",
            "error"
          ]
        },
        {
          "description": "A crash interrupted it.",
          "type": "object",
          "properties": {
            "found": {
              "description": "What reconciliation found.",
              "$ref": "#/$defs/FoundOut"
            },
            "result": {
              "type": "string",
              "const": "indeterminate"
            }
          },
          "additionalProperties": false,
          "required": [
            "result",
            "found"
          ]
        }
      ]
    },
    "SkipOut": {
      "description": "Why an item was dropped before anything of it was touched.",
      "oneOf": [
        {
          "description": "The authorization isn't for this plan.",
          "type": "object",
          "properties": {
            "skip": {
              "type": "string",
              "const": "not-reviewed"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip"
          ]
        },
        {
          "description": "Something it was judged under changed.",
          "type": "object",
          "properties": {
            "field": {
              "description": "What.",
              "$ref": "#/$defs/JudgementField"
            },
            "skip": {
              "type": "string",
              "const": "rejudged"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "field"
          ]
        },
        {
          "description": "It is Protected now.",
          "type": "object",
          "properties": {
            "holds": {
              "description": "Why.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Hold"
              }
            },
            "skip": {
              "type": "string",
              "const": "protected"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "holds"
          ]
        },
        {
          "description": "It carries cautions it wasn't authorized with.",
          "type": "object",
          "properties": {
            "cautions": {
              "description": "Which.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Caution"
              }
            },
            "skip": {
              "type": "string",
              "const": "riskier"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "cautions"
          ]
        },
        {
          "description": "Its rule doesn't offer its method any more.",
          "type": "object",
          "properties": {
            "method": {
              "description": "The method.",
              "$ref": "#/$defs/Method"
            },
            "skip": {
              "type": "string",
              "const": "method-not-offered"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "method"
          ]
        },
        {
          "description": "The fresh freeze failed.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why.",
              "$ref": "#/$defs/ErrorOut"
            },
            "skip": {
              "type": "string",
              "const": "freeze"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "error"
          ]
        },
        {
          "description": "The executor or the trash refused it before touching anything.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why.",
              "$ref": "#/$defs/ErrorOut"
            },
            "skip": {
              "type": "string",
              "const": "refused"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "error"
          ]
        },
        {
          "description": "It is on a file system kipple doesn't change.",
          "type": "object",
          "properties": {
            "skip": {
              "type": "string",
              "const": "file-system"
            },
            "why": {
              "description": "Why not.",
              "$ref": "#/$defs/UnsupportedOut"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "why"
          ]
        },
        {
          "description": "Revalidation dropped every reviewed entry.",
          "type": "object",
          "properties": {
            "left": {
              "description": "What it dropped, by reason.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/LeftOut"
              }
            },
            "skip": {
              "type": "string",
              "const": "all-dropped"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "left"
          ]
        },
        {
          "description": "A trash move needs a whole-directory review automation doesn't have.",
          "type": "object",
          "properties": {
            "skip": {
              "type": "string",
              "const": "whole-not-reviewed"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip"
          ]
        },
        {
          "description": "A trash move needs every entry still authorized.",
          "type": "object",
          "properties": {
            "excluded": {
              "description": "How many entries the plan left out.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "left": {
