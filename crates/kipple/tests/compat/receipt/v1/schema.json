            "skip"
          ]
        },
        {
          "description": "It can't be judged now.",
          "type": "object",
          "properties": {
            "skip": {
              "type": "string",
              "const": "unjudged"
            },
            "why": {
              "description": "Why.",
              "$ref": "#/$defs/Unjudged"
            }
          },
          "additionalProperties": false,
          "required": [
            "skip",
            "why"
          ]
        },
        {
          "description": "The host protects it.",
          "type": "object",
          "properties": {
            "protection": {
              "description": "What protects it.",
